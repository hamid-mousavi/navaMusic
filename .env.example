# ========================================================
# سامانه پخش و مدیریت مداحی و ادعیه (navaMusic)
# فایل راهنمای متغیرهای محیطی (.env.example)
# ========================================================

# پیکربندی سرور و محیط اجرا
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# مسیر پوشه داده‌ها (دیتابیس SQLite و فایل‌های موقت staging)
DATA_DIR=./data

# امنیت نشست‌ها و ارتباطات داخلی
SESSION_SECRET=change_this_to_a_secure_random_secret_in_production
INTERNAL_API_TOKEN=change_this_to_a_secure_token_for_internal_worker_calls

# کاربر مدیر اولیه جهت بوت‌استرپ سامانه در فاز ۲ (فقط اولین اجرا)
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=admin_secure_password_here

# شناسه‌های عددی ادمین‌های تلگرام مجاز (با کاما جدا شود: 12345678,87654321)
ADMIN_IDS=

# اطلاعات ربات اصلی تلگرام (grammY) و کانال انتشار رسمی
TELEGRAM_BOT_TOKEN=
TELEGRAM_TARGET_CHANNEL=@madahi_channel

# اطلاعات احراز هویت کلاینت Telethon (فقط ورکر پایتون اسکرپر تلگرام)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# پروکسی جهت درخواست‌های خروجی به یوتیوب و تلگرام (اختیاری، مثلا: socks5://127.0.0.1:1080 یا http://proxy:8080)
OUTBOUND_PROXY=

# مسیر امن فایل کوکی یوتیوب خارج از گیت
YOUTUBE_COOKIES_PATH=./data/youtube_cookies.txt

# تنظیمات فضای ابری S3 ابر آروان (ArvanCloud Object Storage)
ARVAN_ACCESS_KEY=
ARVAN_SECRET_KEY=
ARVAN_BUCKET=madahi-media-vault
ARVAN_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
ARVAN_REGION=ir-thr-at1
ARVAN_CDN_DOMAIN=

# کلید هوش مصنوعی جمینای جهت استخراج و پیشنهاد هوشمند متادیتای آثار
GEMINI_API_KEY=

# حداکثر زمان نگهداری فایل‌های staging بدون بررسی (روز)
STAGING_TTL_DAYS=7

# سقف مجاز اندازه دانلود رسانه‌ها (مگابایت)
MAX_DOWNLOAD_MB=200
