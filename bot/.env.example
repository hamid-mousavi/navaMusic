# -------------------------------------------------------------
# تنظیمات محیطی ربات تلگرام گردآورنده مداحی و ارسال به ابر آروان
# -------------------------------------------------------------

# ۱. مشخصات اکانت تلگرام (از سایت https://my.telegram.org دریافت کنید)
TELEGRAM_API_ID="12345678"
TELEGRAM_API_HASH="0123456789abcdef0123456789abcdef"
TELEGRAM_PHONE="+989120000000"

# ۲. توکن ربات ادمین تلگرام (جهت ارسال اعلان به شما هنگام دریافت مداحی جدید - اختیاری)
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRstuVWXyz"
ADMIN_TELEGRAM_CHAT_ID="987654321"

# ۳. تنظیمات فضای ذخیره‌سازی ابری ابر آروان (ArvanCloud S3)
ARVAN_S3_ENDPOINT="https://s3.ir-thr-at1.arvanstorage.ir"
ARVAN_S3_BUCKET="madahi-media-vault"
ARVAN_S3_REGION="ir-thr-at1"
ARVAN_ACCESS_KEY="arvan_ak_your_access_key_here"
ARVAN_SECRET_KEY="arvan_sk_your_secret_key_here"
# دامین CDN اختیاری (اگر دامنه اختصاصی ندارید، این مقدار را خالی بگذارید تا مستقیماً از آدرس باکت آروان استفاده شود)
ARVAN_CDN_DOMAIN=""

# ۴. مشخصات پایگاه داده Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ۵. آدرس وب اپلیکیشن پنل مدیریت (برای قرار دادن لینک در اعلان تلگرام)
APP_ADMIN_URL="https://your-app.vercel.app"

# ۶. تنظیمات پروکسی تلگرام (در صورت نیاز به عبور از محدودیت روی سرورهای داخل ایران)
# فرمت: socks5://user:pass@127.0.0.1:1080 یا خالی بگذارید
TELEGRAM_PROXY=""
